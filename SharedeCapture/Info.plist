<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>$(SHAREDEE_DISPLAY_NAME)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.graphics-design</string>
	<key>LSUIElement</key>
	<true/>
	<key>NSHumanReadableCopyright</key>
	<string>Copyright © 2026 Duy Chu. Licensed under the Apache License 2.0.</string>
	<key>NSScreenCaptureUsageDescription</key>
	<string>Sharedee Tools needs Screen Recording permission to capture your screen.</string>
	<key>SharedeeGoogleOAuthClientID</key>
	<string>$(SHAREDEE_GOOGLE_CLIENT_ID)</string>
	<key>SharedeeGoogleOAuthClientSecret</key>
	<string>$(SHAREDEE_GOOGLE_CLIENT_SECRET)</string>
	<key>SharedeeRepositoryURL</key>
	<string>https://github.com/dychu2307/sharedee-tools</string>
</dict>
</plist>
